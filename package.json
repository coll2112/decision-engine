{
  "name": "@coll2112/decision-engine",
  "version": "0.2.0",
  "description": "A TypeScript decision engine for branching story data, runtime state, and section-aware presentation.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./story.schema.json": "./schema/story.schema.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coll2112/decision-engine.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "schema/story.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2020 --strict --skipLibCheck test/types/generic-api.ts",
    "verify": "npm run typecheck && npm test",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^5.0.0"
  }
}
